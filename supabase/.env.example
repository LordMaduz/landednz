# Read by `supabase start` for env(...) in config.toml. Copy to supabase/.env (gitignored) — `make env` does.
# Google Cloud Console → Credentials → "LandedNZ Local Dev" client. Setup: https://supabase.com/docs/guides/auth/social-login/auth-google (redirect URI http://127.0.0.1:54321/auth/v1/callback)
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
