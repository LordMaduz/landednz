# Local Supabase instance
SUPABASE_URL=http://127.0.0.1:54321

# Local PostgreSQL (from docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/landednz

# Anthropic API — for chat advisor (Job B)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI API — for RAG embeddings (text-embedding-3-small, 1536 dimensions)
OPENAI_API_KEY=

# Optional — admin endpoint protection. If set, POST /admin/recalculate requires X-Admin-Key header.
# ADMIN_API_KEY=
