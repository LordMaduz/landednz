# Local values for the Supabase CLI stack (`supabase start`). Copy to .env.local.
# Keys below are the Supabase CLI's local defaults (`supabase status -o env`), not secrets.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

PORT=3001
NODE_ENV=development
# Comma-separated web origins
CORS_ORIGIN=http://localhost:3000

# live = real Claude + OpenAI; mock = deterministic replies and embeddings (tests, CI)
AI_MODE=live
# Per-user chat messages per NZ day
CHAT_DAILY_CAP=50

# Anthropic API — chat advisor (Job B). Local/tests use Haiku to save cost; staging/production use claude-sonnet-5-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# OpenAI API — RAG embeddings (text-embedding-3-small, 1536 dimensions)
OPENAI_API_KEY=

# Optional — if set, POST /admin/recalculate requires X-Admin-Key header.
# ADMIN_API_KEY=
# Optional — bypass subscription checks
# BETA_MODE=true
