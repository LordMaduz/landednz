{
  "name": "@landednz/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env.local --import=tsx/esm src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "test": "vitest",
    "test:run": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "typecheck": "tsc --noEmit",
    "db:bootstrap": "node --env-file=.env.local --import=tsx/esm scripts/bootstrap.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.79.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@landednz/types": "*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "5.12",
    "jose": "^6.2.1",
    "openai": "^6.32.0",
    "pino": "^9.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "dotenv": "^17.4.1",
    "pino-pretty": "^13.0.0",
    "prisma": "7.10.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^1.6.0"
  }
}
