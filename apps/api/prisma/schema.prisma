generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String             @id @default(uuid())
  email          String             @unique
  name           String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  chatSessions   ChatSession[]
  subscription   Subscription?
  profile        UserProfile?
  roadmapEntries UserRoadmapEntry[]
}

model UserProfile {
  id              String          @id @default(uuid())
  userId          String          @unique
  visaType        VisaType
  city            City
  familySituation FamilySituation
  occupation      Occupation
  arrivalDate     DateTime
  personaKey      String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id                         String               @id
  name                       String
  phase                      Int
  basePriority               Int
  estimatedDuration          String
  processingTime             String?
  governmentSourceUrl        String
  taskType                   TaskType             @default(FREE)
  contentVersion             Int                  @default(1)
  applicableVisaTypes        String
  applicableFamilySituations String
  applicableOccupations      String
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  contentVariants            TaskContentVariant[]
  dependencies               TaskDependency[]     @relation("DependentTask")
  dependents                 TaskDependency[]     @relation("PrerequisiteTask")
  roadmapEntries             UserRoadmapEntry[]
}

model TaskDependency {
  id             String         @id @default(uuid())
  prerequisiteId String
  dependentId    String
  dependencyType DependencyType
  dependent      Task           @relation("DependentTask", fields: [dependentId], references: [id])
  prerequisite   Task           @relation("PrerequisiteTask", fields: [prerequisiteId], references: [id])

  @@unique([prerequisiteId, dependentId])
}

model TaskContentVariant {
  id                         String   @id @default(uuid())
  taskId                     String
  personaKey                 String
  consequenceLine            String
  steps                      String
  documentsRequired          String
  commonMistakes             String
  watchOuts                  String   @default("[]")
  cost                       String?
  professionalAdviceRequired Boolean  @default(false)
  professionalAdviceNote     String?
  sourceUrl                  String
  contentVersion             Int      @default(1)
  aiPersonalisationPrompt    String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  task                       Task     @relation(fields: [taskId], references: [id])

  @@unique([taskId, personaKey])
}

model UserRoadmapEntry {
  id               String            @id @default(uuid())
  userId           String
  taskId           String
  status           TaskStatus        @default(NOT_STARTED)
  priorityScore    Int
  isBlocked        Boolean           @default(false)
  completedAt      DateTime?
  completionMethod CompletionMethod?
  lastSyncVersion  Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  task             Task              @relation(fields: [taskId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
}

model KnowledgeBaseChunk {
  id             String    @id @default(uuid())
  chunkKey       String    @unique
  taskId         String?
  personaKey     String?
  chunkType      ChunkType
  content        String
  sourceUrl      String
  sourceName     String
  contentVersion Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model KnowledgeBaseVersion {
  id             Int      @id @default(1)
  currentVersion Int      @default(1)
  lastUpdated    DateTime @default(now())
  updatedBy      String?
}

model ChatSession {
  id          String         @id @default(uuid())
  userId      String
  entryPoint  ChatEntryPoint
  taskContext String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  messages    ChatMessage[]
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id              String      @id @default(uuid())
  sessionId       String
  role            MessageRole
  content         String
  retrievedChunks String?
  guardrailFlags  String?
  level2Flags     String?
  createdAt       DateTime    @default(now())
  session         ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Subscription {
  id               String            @id @default(uuid())
  userId           String            @unique
  isActive         Boolean           @default(false)
  plan             SubscriptionPlan?
  revenueCatUserId String?           @unique
  expiresAt        DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum VisaType {
  AEWV
  PARTNER_OF_STUDENT
  GREEN_LIST_WORK
  GREEN_LIST_RESIDENCE
  OTHER
}

enum City {
  AUCKLAND
  WELLINGTON
  CHRISTCHURCH
  OTHER
}

enum FamilySituation {
  SOLO
  COUPLE_DUAL_WORK
  COUPLE_CONSTRAINED
  FAMILY_WITH_CHILDREN
}

enum Occupation {
  TECHNOLOGY
  HEALTHCARE
  EDUCATION
  FINANCE
  TRADES
  OTHER_PROFESSIONAL
  SEEKING_WORK
}

enum TaskType {
  FREE
  PREMIUM
}

enum DependencyType {
  HARD
  SOFT
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  SKIPPED
}

enum CompletionMethod {
  USER_MARKED
  BULK_OVERRIDE
}

enum ChunkType {
  TASK_CONTENT
  SETTLEMENT_CONTEXT
  POLICY_REFERENCE
}

enum ChatEntryPoint {
  TASK_CARD
  ROADMAP
  EMAIL_DEEPLINK
  NAVIGATION
}

enum MessageRole {
  USER
  ASSISTANT
}

enum SubscriptionPlan {
  MONTHLY
  SIX_MONTH
}
