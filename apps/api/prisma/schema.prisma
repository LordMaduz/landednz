generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String             @id @default(uuid())
  email          String             @unique
  name           String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  subscription   Subscription?
  profile        UserProfile?
  roadmapEntries UserRoadmapEntry[]
  guideConversation GuideConversation?
  guideMemories     GuideMemory[]
}

model UserProfile {
  id              String          @id @default(uuid())
  userId          String          @unique
  visaType        VisaType
  city            City
  familySituation FamilySituation
  occupation      Occupation
  arrivalDate     DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserRoadmapEntry {
  id               String            @id @default(uuid())
  userId           String
  taskId           String
  status           TaskStatus        @default(NOT_STARTED)
  priorityScore    Int
  isBlocked        Boolean           @default(false)
  completedAt      DateTime?
  completionMethod CompletionMethod?
  lastSyncVersion  Int               @default(1)
  contentVersion   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
}

model KnowledgeBaseChunk {
  id             String    @id @default(uuid())
  chunkKey       String    @unique
  taskId         String?
  chunkType      ChunkType
  content        String
  sourceUrl      String
  sourceName     String
  contentVersion Int       @default(1)
  when           Json?
  contentHash    String?
  itemIds        String?
  sourceIds      String?
  embeddingMode  String?
  embedding      Unsupported("vector(1536)")?
  // GENERATED ALWAYS column from the migration (raw SQL); dbgenerated mirrors it so migrate diff stays clean. Keyword arm of guide retrieval
  searchText     Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, content)"))
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // ivfflat (vector_cosine_ops) is created by scripts/create-vector-index.ts; declared so migrate diff keeps it
  @@index([embedding], map: "kb_chunk_embedding_ivfflat")
  @@index([searchText], map: "kb_chunk_search_text_gin", type: Gin)
}

// Each content bundle the API has served
model ContentRelease {
  version    String   @id
  builtAt    DateTime
  servedFrom DateTime @default(now())
}

model Subscription {
  id               String            @id @default(uuid())
  userId           String            @unique
  isActive         Boolean           @default(false)
  plan             SubscriptionPlan?
  revenueCatUserId String?           @unique
  expiresAt        DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum VisaType {
  AEWV
  STRAIGHT_TO_RESIDENCE
  SKILLED_MIGRANT_RESIDENT
  PARTNER_WORK
  POST_STUDY_WORK
  SPECIFIC_PURPOSE_WORK
  WORKING_HOLIDAY
  OTHER
}

enum City {
  AUCKLAND
  WELLINGTON
  CHRISTCHURCH
  OTHER
}

enum FamilySituation {
  SOLO
  COUPLE_DUAL_WORK
  COUPLE_CONSTRAINED
  FAMILY_WITH_CHILDREN
  SOLE_PARENT
}

enum Occupation {
  HEALTHCARE
  EDUCATION
  TRADES
  OTHER_PROFESSIONAL
  SEEKING_WORK
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  SKIPPED
}

enum CompletionMethod {
  USER_MARKED
  BULK_OVERRIDE
}

enum ChunkType {
  TASK_CONTENT
  SETTLEMENT_CONTEXT
  POLICY_REFERENCE
}

enum SubscriptionPlan {
  MONTHLY
  SIX_MONTH
}

// Settlement guide: one continuous conversation per user
model GuideConversation {
  id        String         @id @default(uuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  GuideMessage[]
  createdAt DateTime       @default(now())
}

// One streaming assistant row per conversation is enforced by the partial unique index guide_message_one_streaming (raw SQL)
model GuideMessage {
  id              String            @id @default(uuid())
  conversationId  String
  conversation    GuideConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            String            // 'user' | 'assistant'
  replyToId       String?           @unique  // assistant row → the user row it answers
  text            String            // user question, or assistant plain text for history replay
  parts           Json?             // assistant ReplyPart[] as sent
  screenKind      String
  taskKey         String?
  status          String            // assistant: 'streaming' | 'complete' | 'failed' | 'interrupted' | 'cancelled'; user: 'complete'
  countsTowardCap Boolean           @default(true)  // user rows only
  meta            Json?             // latency per step, tokens, cost, steps run, verify result
  createdAt       DateTime          @default(now())
  streamStartedAt DateTime          @default(now())  // reset on restart; the sweeper ages streaming rows by this

  @@index([conversationId, createdAt])
  @@index([conversationId, taskKey])
}

model GuideMemory {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text            String
  sourceMessageId String?
  editedByUser    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model LiveSourceCache {
  url       String   @id
  title     String
  content   String   // page text, capped at 100k characters
  fetchedAt DateTime
}
