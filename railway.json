{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/api/Dockerfile"
  },
  "deploy": {
    "preDeployCommand": ["sh -c \"cd apps/api && npx prisma migrate deploy\""],
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
